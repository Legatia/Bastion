{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-any",
          "cmd": "**",
          "args": true
        }
      ]
    },
    "shell:allow-open",
    "opener:default",
    "deep-link:default"
  ]
}