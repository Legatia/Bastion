{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "src/index.ts"
        },
        {
            "src": "/v1/(.*)",
            "dest": "src/index.ts",
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
                "Access-Control-Allow-Headers": "Content-Type, X-API-Key, Authorization"
            }
        },
        {
            "src": "/health",
            "dest": "src/index.ts",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        }
    ]
}