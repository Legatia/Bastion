// Bastion Protocol Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users and Authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String?

  // API Keys for CLI/SDK authentication
  apiKey    String   @unique @default(uuid())

  // Stripe Billing
  stripeCustomerId String? @unique

  // Subscription tier
  tier      SubscriptionTier @default(FREE)
  stripeSubscriptionId String?   // Active Stripe Subscription ID for tier billing

  // Add-ons
  openclawPurchased Boolean @default(false)
  moduleSubscriptions ModuleSubscription[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth
  googleId  String?  @unique

  // Relations
  policies  Policy[]
  actionLogs ActionLog[]
  usageMetrics UsageMetric[]
  agents    Agent[]

  // Referral system
  referralCode       String    @unique @default(uuid())
  referredByCode     String?
  firstPaymentDiscount Boolean @default(false)
  totalReferrals     Int       @default(0)
  activeReferrals    Int       @default(0)

  coupons            Coupon[]
  monthlyDiscounts   MonthlyDiscount[]
  // PolarDiscountCode removed (migrated to Stripe)
  referralsMade      Referral[] @relation("Referrer")
  referralReceived   Referral?  @relation("Referred")

  @@map("users")
}

enum SubscriptionTier {
  FREE       // Default, no credit card required
  STARTER    // $29/mo
  PRO        // $79/mo
  ENTERPRISE // Custom
}

// ModuleType kept for data preservation (legacy module_subscriptions table)
enum ModuleType {
  OPENCLAW
  BASTION_PROXY
  ERC8004_LITE
  ERC8004_STANDARD
  ERC8004_REALTIME
  MOLTMIND
}

// Agents (Instances being monitored)
model Agent {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?

  // Agent metadata
  language    String?  // python, nodejs, etc
  framework   String?  // langchain, autogpt, etc

  // Status
  status      AgentStatus @default(ACTIVE)
  lastSeenAt  DateTime?

  // CDP Server Wallet
  cdpWalletAddress    String?   // EVM address from CDP
  cdpAccountName      String?   @unique // "bastion-agent-{uuid}" for idempotent provisioning

  // ERC-8004 On-chain Identity
  onchainId           String?   // tokenId from registry
  registryChain       String?   // e.g. "avalanche" | "avalanche-fuji"
  registryAddress     String?   // Identity Registry contract address
  agentURI            String?   // URL to registration file
  ownerAddress        String?   // Wallet that owns the NFT
  registrationTxHash  String?   // Transaction hash of on-chain registration
  registeredAt        DateTime? // When agent was verified on-chain

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionLogs  ActionLog[]
  moduleSubscriptions ModuleSubscription[]
  
  // MoltMind Relations
  behavioralEvents  BehavioralEvent[]
  baselines         AgentBaseline[]
  cognitiveAlerts   CognitiveAlert[]
  healthScores      AgentHealthScore[]

  @@map("agents")
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// Module Subscriptions (per-agent billing)
model ModuleSubscription {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId     String?    // null for user-level modules (e.g. OpenClaw)
  agent       Agent?     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  module      ModuleType
  active      Boolean    @default(true)

  // Billing metadata
  priceAtActivation Int?  // Price in cents at time of activation
  stripeSubscriptionId String? // Linked Stripe Subscription ID
  activatedAt DateTime   @default(now())
  cancelledAt DateTime?

  @@unique([userId, agentId, module])
  @@index([userId, active])
  @@map("module_subscriptions")
}
// MoltMind - Cognitive Monitoring Models
// ========================================

// Behavioral events captured from traffic
model BehavioralEvent {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  // Event classification
  eventType   String   // 'api_call', 'message_send', 'payment', 'code_action'
  endpoint    String   // Normalized destination URL/API
  method      String   // HTTP method
  
  // Behavioral signals (not content itself)
  contentLength    Int?
  contentHash      String?      // SHA256 hash for dedup, not content
  sentimentScore   Float?       // -1.0 to 1.0
  topicTags        String[]     // ['finance', 'social', 'technical']
  
  // Interaction metadata
  targetAgentId    String?      // If interacting with another agent
  responseTimeMs   Int?
  
  // Timing
  timestamp        DateTime     @default(now())
  
  @@index([agentId, timestamp])
  @@index([agentId, eventType])
  @@map("behavioral_events")
}

// Computed baselines per agent
model AgentBaseline {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  // Baseline window
  windowStart DateTime
  windowEnd   DateTime
  eventCount  Int
  
  // Behavioral metrics (stored as JSON for flexibility)
  metrics     Json
  // Example: { requestRate: {mean, stddev}, sentimentMean, topEndpoints, activeHours }
  
  isActive    Boolean  @default(true)  // Current baseline
  createdAt   DateTime @default(now())
  
  @@index([agentId, isActive])
  @@map("agent_baselines")
}

// Drift events / anomalies detected
model CognitiveAlert {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  alertType   String   // 'identity_drift', 'manipulation_detected', 'anomaly'
  severity    String   // 'low', 'medium', 'high', 'critical'
  
  // What triggered it
  metric      String   // Which metric drifted
  baselineValue Float?
  currentValue  Float?
  driftScore    Float   // How far from baseline (0-1)
  
  // Context
  details     Json     // Additional context
  
  // Status
  acknowledged Boolean @default(false)
  resolvedAt   DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([agentId, createdAt])
  @@index([alertType, severity])
  @@map("cognitive_alerts")
}

// Agent health score (computed periodically)
model AgentHealthScore {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  // Overall score
  overallScore        Int      // 0-100
  
  // Component scores
  identityCoherence   Int      // 0-100
  behavioralStability Int      // 0-100
  interactionHealth   Int      // 0-100
  
  // Flags
  activeFlags     String[]  // ['high_drift', 'new_partner_dominant', etc]
  
  computedAt      DateTime @default(now())
  
  @@index([agentId, computedAt])
  @@map("agent_health_scores")
}

// Policies (Security Rules)
model Policy {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?

  // Policy type and configuration
  type        PolicyType
  config      Json     // Flexible JSON for different policy types

  // Status
  enabled     Boolean  @default(true)
  priority    Int      @default(0) // Higher priority = evaluated first

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionLogs  ActionLog[]

  @@map("policies")
}

enum PolicyType {
  SPENDING_LIMIT    // Max spending per time window
  RATE_LIMIT        // Max requests per time window
  PATTERN_MATCH     // Regex/pattern matching on actions
  FILE_PROTECTION   // Protect specific files/directories
  DLP               // Data Loss Prevention (detect PII, secrets)
  CUSTOM_WEBHOOK    // Call external API for decision
  TIME_WINDOW       // Only allow actions during specific hours
  ALLOWLIST         // Only allow specific actions
  BLOCKLIST         // Block specific actions
}

// Action Logs (Audit Trail)
model ActionLog {
  id          String   @id @default(uuid())
  userId      String
  agentId     String?
  policyId    String?

  // Action details
  actionType      String   // e.g., "http_request", "file_write", "subprocess"
  actionData      Json?    // Full action payload (plain, if not encrypted)
  encryptedData   String?  // Encrypted action payload (if encryption enabled)
  spendingAmount  Float?   // Extracted amount for spending limit tracking (unencrypted)

  // Decision
  decision    Decision
  reason      String?  // Why was it allowed/blocked

  // Timing
  latencyMs   Int?     // How long did evaluation take
  timestamp   DateTime @default(now())

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  policy      Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([agentId, timestamp])
  @@index([decision])
  @@map("action_logs")
}

enum Decision {
  ALLOWED
  BLOCKED
  ERROR
}

// Usage Metrics (For Billing)
model UsageMetric {
  id            String   @id @default(uuid())
  userId        String

  // Date bucket
  date          DateTime @db.Date

  // Metrics
  checksCount   Int      @default(0)
  blockedCount  Int      @default(0)
  allowedCount  Int      @default(0)
  errorCount    Int      @default(0)

  // Cost tracking
  totalLatencyMs BigInt  @default(0)

  // Relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("usage_metrics")
}
// Add this to the end of schema.prisma

// Referral Coupon System
model Coupon {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Coupon details
  value             Float     @default(0.05)  // 5% discount
  used              Boolean   @default(false)
  usedAt            DateTime?

  // Source tracking
  earnedFrom        String?   // Referral ID that created this coupon

  createdAt         DateTime  @default(now())

  @@index([userId, used])
  @@map("coupons")
}

model Referral {
  id                String    @id @default(uuid())

  referrerId        String
  referrer          User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  referredId        String    @unique
  referred          User      @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  status            ReferralStatus @default(PENDING)

  signupAt          DateTime  @default(now())
  firstPaymentAt    DateTime?
  lastActiveAt      DateTime?
  cancelledAt       DateTime?

  @@index([referrerId, status])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING       // Signed up, not paid yet
  ACTIVE        // Paying customer
  CHURNED       // Cancelled
}

model MonthlyDiscount {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Month tracking
  monthStart        DateTime  // First day of month 00:00:00
  monthEnd          DateTime  // Last day of month 23:59:59

  // Usage (max 10 coupons = 50% per month)
  couponsUsed       Int       @default(0)  // Max 10 per month
  discountApplied   Float     @default(0)  // Max 0.50 (50%)

  createdAt         DateTime  @default(now())

  @@unique([userId, monthStart])
  @@map("monthly_discounts")
}

// Webhook Event Tracking (for idempotency)
model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique  // From external provider (Polar, etc.)
  type        String
  processedAt DateTime @default(now())

  @@index([eventId])
  @@map("webhook_events")
}

