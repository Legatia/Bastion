# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bastion?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Configuration
API_VERSION=v1

# Backend URL (used for ERC-8004 profile.json links)
BACKEND_URL=https://bastion-gamma.vercel.app

# CORS (comma-separated list of allowed origins)
# Production: Set to your actual frontend URLs
FRONTEND_URL=https://bastion.legatia.solutions
# For local development: http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Stripe Billing
# Get these from Stripe Dashboard (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create products in Stripe Dashboard first)
STRIPE_PRICE_ID_STARTER=price_starter_id_here
STRIPE_PRICE_ID_PRO=price_pro_id_here
STRIPE_PRICE_ID_OPENCLAW=price_agent_runtime_id_here

# Coinbase Developer Platform (CDP) — Server Wallet v2
# Get these from https://cdp.coinbase.com
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret
CDP_WALLET_SECRET=your-cdp-wallet-secret

# Logging
LOG_LEVEL=info

# Error Monitoring (optional, recommended for production)
# Sign up at https://sentry.io and create a Node.js project
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Uptime Monitoring (external services - configure at provider)
# Recommended: UptimeRobot (free), Pingdom, or Better Uptime
# Monitor these endpoints:
#   - GET https://your-backend.vercel.app/health
#   - Expected: {"status":"healthy",...}
