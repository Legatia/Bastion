# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bastion?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Configuration
API_VERSION=v1

# CORS (comma-separated list of allowed origins)
# Production: Set to your actual frontend URLs
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Webhook Security
# Get this from Polar.sh dashboard
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret-here

# Logging
LOG_LEVEL=info
