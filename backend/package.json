{
  "name": "@bastion/backend",
  "version": "0.1.0",
  "description": "Bastion Protocol Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "vercel-build": "prisma generate && prisma migrate deploy && tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
